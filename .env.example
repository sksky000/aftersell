# 复制为 .env 后填写；或在服务器上运行 deploy/init-env.sh 自动生成密钥
# .env 不进仓库

# --- 数据库 ---
POSTGRES_PASSWORD=

# --- 密钥（openssl rand -base64 48 / openssl rand -base64 32）---
JWT_SECRET=
# 邮箱授权码加密密钥：32 字节 base64。更换后已保存的授权码需在设置页重新填写
MAIL_SECRET_KEY=

# --- 邮件服务器白名单（逗号分隔）---
MAIL_HOST_ALLOWLIST=imap.exmail.qq.com,smtp.exmail.qq.com,hwimap.exmail.qq.com,hwsmtp.exmail.qq.com

# --- 初始管理员：仅在库里没有任何用户时创建一次，首次登录须改密 ---
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# --- 访问地址 ---
# 有域名：SITE_HOST=mail.example.com，TLS_ISSUER=你的邮箱（自动申请证书）
# 只有 IP：SITE_HOST=1.2.3.4，TLS_ISSUER=internal（自签证书）
SITE_HOST=
TLS_ISSUER=internal
COOKIE_SECURE=true

# --- 本地开发（不用 docker 时）---
# DATABASE_URL=postgres://aftersell:密码@localhost:5432/aftersell
# REDIS_URL=redis://localhost:6379
# COOKIE_SECURE=false
